echo "Syncing to wolf-grid.com..."
scp -r $FILES root@wolf-grid.com:/root/wolfserve/

echo "Syncing to 100.83.218.9..."
scp -r $FILES root@100.83.218.9:/mnt/shared/wolfserve/
